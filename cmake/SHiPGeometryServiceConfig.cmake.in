@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Hint the build-time dependency prefixes so find_dependency succeeds
# without downstream consumers needing to add transitive deps to
# CMAKE_PREFIX_PATH. HINTS (searched before the default paths) avoids
# mutating the consumer's CMAKE_PREFIX_PATH, which a failing
# find_dependency's early return would leave un-restored.
set(_SHiPGS_extra_prefixes "@_geometry_prefix@")
list(FILTER _SHiPGS_extra_prefixes EXCLUDE REGEX "^$")

find_dependency(SHiPGeometry CONFIG REQUIRED HINTS ${_SHiPGS_extra_prefixes})
find_dependency(GeoModelCore 6.30 CONFIG REQUIRED HINTS ${_SHiPGS_extra_prefixes})
find_dependency(GeoModelIO 6.30 CONFIG REQUIRED HINTS ${_SHiPGS_extra_prefixes})
find_dependency(GeoModelG4 CONFIG REQUIRED HINTS ${_SHiPGS_extra_prefixes})
find_dependency(Geant4 CONFIG REQUIRED HINTS ${_SHiPGS_extra_prefixes})
find_dependency(Threads REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/SHiPGeometryServiceTargets.cmake")

# Transitional name for the stuttering pre-0.5.0 spelling, removed in 0.6.0.
# A plain INTERFACE IMPORTED target rather than an ALIAS, because
# install(EXPORT) does not mark its imported targets GLOBAL and ALIAS refuses a
# non-global one.
if(NOT TARGET SHiPGeometryService::SHiPGeometryService)
    add_library(SHiPGeometryService::SHiPGeometryService INTERFACE IMPORTED)
    set_target_properties(
        SHiPGeometryService::SHiPGeometryService
        PROPERTIES INTERFACE_LINK_LIBRARIES SHiP::GeometryService
    )
endif()

check_required_components(SHiPGeometryService)

unset(_SHiPGS_extra_prefixes)
